# Copy to .env and fill in. Never commit .env.

# --- Server
PORT=5000
# Number of proxy hops in front of the API once deployed (e.g. 1 on Render/Railway).
# Leave empty locally. Needed so rate limits apply per visitor, not per proxy.
TRUST_PROXY=
# Site(s) allowed to call the API, comma-separated (e.g. https://sbo.vercel.app).
# Leave empty locally to allow any origin.
CORS_ORIGIN=

# --- MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sbo
# Tests rebuild this database on every run; the name must end in "_test".
TEST_DB_NAME=sbo_test

# --- Auth
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# --- Emails (password reset links)
# Where the frontend runs; used to build the link in the email.
FRONTEND_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# For Gmail, an app password (Google account → Security → App passwords), not your login password.
SMTP_PASS=

# --- Optional: "Nearby stores" map on the Stores page
GOOGLE_PLACES_API_KEY=
